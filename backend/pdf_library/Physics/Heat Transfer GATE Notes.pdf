hforced conv. &gt; hfree conv. âŸ¹ Qforced conv. &gt; Qfree conv
 " loading="lazy" decoding="async"><img id="slide-image-2" class="VerticalSlideImage-module__XJvZGG__image VerticalSlideImage-module__XJvZGG__loaded" alt="" aria-hidden="true" data-testid="vertical-slide-image" decoding="async" fetchpriority="auto" loading="lazy" src="https://image.slidesharecdn.com/heattransfer-210310120152/75/Heat-transfer-GATE-notes-3-2048.jpg"></div><div class="slide-overlay-module__pxF2tG__root"></div><div class="vertical-slide-actions-module__LZgj6q__root"><button type="button" class="button Button-module__4HgN-q__root Button-module__4HgN-q__primary Button-module__4HgN-q__outlined Button-module__4HgN-q__medium Button-module__4HgN-q__icon Button-module__4HgN-q__icon slide-download-button" aria-label="Download presentation Heat transfer GATE notes"><span class="Button-module__4HgN-q__iconSlot"><span class="Button-module__4HgN-q__iconEl"><span role="img" aria-label="download icon" class="icon Icon-module__J9mFQG__icon Icon-module__J9mFQG__mask" style="--icon: url(/images/next/svg/download.svg?v=undefined);"></span></span><span class="Button-module__4HgN-q__spinnerEl"><svg class="spinner" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 50 50" width="16" height="16" fill="currentColor" data-dd-excluded-activity-mutations="true"><path d="M43.935,25.145c0-10.318-8.364-18.683-18.683-18.683c-10.318,0-18.683,8.365-18.683,18.683h4.068c0-8.071,6.543-14.615,14.615-14.615c8.072,0,14.615,6.543,14.615,14.615H43.935z"><animateTransform attributeType="xml" attributeName="transform" type="rotate" from="0 25 25" to="360 25 25" dur="0.6s" repeatCount="indefinite"></animateTransform></path></svg></span></span></button><button type="button" class="button Button-module__4HgN-q__root Button-module__4HgN-q__primary Button-module__4HgN-q__outlined Button-module__4HgN-q__medium Button-module__4HgN-q__icon Button-module__4HgN-q__icon" aria-label="Save heat-transfer-gate-notes for later"><span class="Button-module__4HgN-q__iconSlot"><span class="Button-module__4HgN-q__icon