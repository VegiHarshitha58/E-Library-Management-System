@charset "utf-8";

.gallery-view-module__NCdH8q__root .modal-content { background-color: var(--color-white); height: 80dvh; max-height: 100svh; padding-block-end: 74px; }

.gallery-view-module__NCdH8q__root .modal-actions { padding: 0px; }

.gallery-view-module__NCdH8q__toolbar { align-items: center; gap: var(--space-8); padding: var(--space-16); background-color: rgb(255, 255, 255); display: flex; }

.gallery-view-module__NCdH8q__toolbar .gallery-view-module__NCdH8q__backButton { color: var(--color-navy-700); background-color: rgba(0, 0, 0, 0); margin-inline-end: auto; position: relative; left: -10px; }

.gallery-view-module__NCdH8q__toolbar .gallery-view-module__NCdH8q__saveButton { background-color: var(--color-navy-100); color: var(--color-navy-700); }

.gallery-view-module__NCdH8q__toolbar .gallery-view-module__NCdH8q__downloadButton { background-color: var(--color-primary); color: rgb(255, 255, 255); }

.gallery-view-module__NCdH8q__backButton { margin-inline-end: auto; }
