@charset "utf-8";

button.rewrite-ai-button-module__EyLNiW__root { z-index: var(--layer-1); display: none; }

@media (min-width: 992px) {
  button.rewrite-ai-button-module__EyLNiW__root { display: flex; }
}

.vertical-slide-actions-module__LZgj6q__root { gap: var(--space-8); inset: 8px; opacity: 1; visibility: visible; flex-direction: column; transition: opacity 0.18s ease-in, visibility 0.18s ease-in; display: flex; position: absolute; inset-inline-start: unset; }

.vertical-slide-actions-module__LZgj6q__root.vertical-slide-actions-module__LZgj6q__hidden { opacity: 0; visibility: hidden; }

@starting-style {
  .vertical-slide-actions-module__LZgj6q__root { opacity: 0; visibility: hidden; }
}

.vertical-slide-actions-module__LZgj6q__root button.vertical-slide-actions-module__LZgj6q__downloadButton { border-radius: var(--radius-4); color: var(--color-navy-700); background-color: var(--color-navy-100); }

.vertical-slide-actions-module__LZgj6q__root button.vertical-slide-actions-module__LZgj6q__downloadButton:hover { color: var(--color-navy-800); background-color: var(--color-white); }

button.vertical-slide-actions-module__LZgj6q__fullscreen { background-color: var(--color-navy-100); color: var(--color-navy-700); margin-block-start: auto; }

@media (max-width: 991px) {
  .vertical-slide-actions-module__LZgj6q__root > div:first-child { display: none; }
}
