@charset "utf-8";

.ActionsMenuTopBar-module__VmiVHq__hidden { visibility: hidden; }

.ActionsMenuTopBar-module__VmiVHq__root { padding-block-start: var(--space-12); padding-block-end: var(--space-4); overflow-x: auto; }

.ActionsMenuTopBar-module__VmiVHq__scroller { gap: var(--space-12); min-width: max-content; display: flex; }

.ActionsMenuTopBar-module__VmiVHq__customButton { border-color: var(--color-black); color: var(--color-black); white-space: nowrap; flex-grow: 1; min-width: max-content; }

.ActionsMenuTopBar-module__VmiVHq__root button { white-space: nowrap; flex-grow: 1; }
