@charset "utf-8";

dialog.FullscreenModal-module__aOFVtG__root[open] { opacity: 1; animation: auto ease 0s 1 normal none running none; scale: 1; }

dialog.FullscreenModal-module__aOFVtG__root { --max-height: 100dvh; border-radius: var(--radius-0); opacity: 0; width: 100lvw; height: 100lvh; scale: 0.96; }

@starting-style {
  dialog.FullscreenModal-module__aOFVtG__root[open] { opacity: 0; scale: 0.96; }
}
